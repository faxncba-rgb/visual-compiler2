{
  "name": "visual-compiler-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Teach browser workflows once, compile them once, and run them locally without an LLM.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "tsc --noEmit",
    "test": "vitest run --exclude tests/security/**",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "screenshot:studio": "node --import tsx scripts/capture-studio.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "1.55.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.1.0",
    "eslint": "9.31.0",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
