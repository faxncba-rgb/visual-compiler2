# Studio is local-only by default.
VC_STUDIO_HOST=127.0.0.1
VC_STUDIO_PORT=3100
VC_FIXTURE_PORT=4273
VISUAL_COMPILER_TARGET_URL=https://dpi-ncba.gbna-sante.fr/

# Automated tests must opt into an explicit local synthetic target.
VISUAL_COMPILER_TEST_TARGET_URL=http://127.0.0.1:4273/fixture?variant=A

# Use 1 only for automated testing. Interactive Lab Mode is headful.
VC_HEADLESS=0

# Required only by normal compile-time GPT-5.6 compilation.
# Put the real value in ignored .env.local with mode 0600. Runtime never receives it.
OPENAI_API_KEY=
